# ── Required ───────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me

DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database ───────────────────────────────────────────────────────────────
# Omit entirely to use SQLite at <project root>/db.sqlite3 (development default).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tedxumt

# ── Frontend origins ───────────────────────────────────────────────────────
# Comma-separated. Must include the scheme and port.
CORS_ALLOWED_ORIGINS=https://yourdomain.com
# Defaults to CORS_ALLOWED_ORIGINS when unset.
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# ── Media ──────────────────────────────────────────────────────────────────
# Relative paths resolve against the project root; absolute paths are used as-is.
MEDIA_ROOT=media

# ── Email (production only) ────────────────────────────────────────────────
# Development prints emails to the console and ignores these.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TEDxUMT Lahore <noreply@tedxumt.pk>
ADMIN_EMAIL=tedxumtlahore@umt.edu.pk
