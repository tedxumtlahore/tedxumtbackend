# ── Required ───────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me

DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database ───────────────────────────────────────────────────────────────
# Omit entirely to use SQLite at <project root>/db.sqlite3 (development default).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tedxumt

# ── Frontend origins ───────────────────────────────────────────────────────
# Comma-separated. Must include the scheme and port.
CORS_ALLOWED_ORIGINS=https://yourdomain.com
# Defaults to CORS_ALLOWED_ORIGINS when unset.
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# ── Ticketing ──────────────────────────────────────────────────────────────
# Public site address. Ticket QR codes and "view your ticket" links are built
# from this, and emails are sent without a request to derive it from.
TICKET_BASE_URL=https://tedxumt.pk

# ── Media ──────────────────────────────────────────────────────────────────
# Where uploads land when Supabase Storage is NOT configured (see below).
# Relative paths resolve against the project root; absolute paths are used as-is.
MEDIA_ROOT=media

# ── Media storage: Supabase Storage ────────────────────────────────────────
# Leave MEDIA_BUCKET empty and everything falls back to MEDIA_ROOT above,
# which is what local development wants.
#
# SET THESE IN PRODUCTION. Render's filesystem is wiped on every deploy, and
# Django does not serve MEDIA_URL at all when DEBUG=False — so without them
# every uploaded image is a 404 the moment it is written.
#
# Two buckets, created in the Supabase dashboard under Storage:
#   tedx-media           PUBLIC   gallery, portraits, sponsor logos, blog covers
#   tedx-payment-proofs  PRIVATE  transfer screenshots, nothing else
# The private one is not optional. A payment screenshot shows the sender's
# wallet balance and recent transactions.
MEDIA_BUCKET=tedx-media
PRIVATE_MEDIA_BUCKET=tedx-payment-proofs

# Supabase dashboard → Storage → S3 access keys → New access key.
# These are NOT the anon/publishable key and must never reach the frontend:
# they grant full read/write to every bucket.
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<your project region, e.g. ap-southeast-1>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Used to build the public image URLs the API hands the frontend:
#   https://<project-ref>.supabase.co/storage/v1/object/public/tedx-media/team/ayesha-3f9a1c2b.jpg
# Optional — falls back to SUPABASE_URL, then to the S3 endpoint's host. Set it
# explicitly if you serve the bucket through a CDN or a custom domain.
SUPABASE_URL=https://<project-ref>.supabase.co
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com

# Seconds a signed payment-proof URL stays valid.
# PRIVATE_URL_EXPIRY=600

# Delete the stored object when an image is replaced or its record removed.
# Set False to keep every version forever. See apps/common/cleanup.py.
# MEDIA_DELETE_ORPHANS=True

# ── Email (production only) ────────────────────────────────────────────────
# Development prints emails to the console and ignores these.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TEDxUMT Lahore <noreply@tedxumt.pk>
ADMIN_EMAIL=tedxumtlahore@umt.edu.pk
